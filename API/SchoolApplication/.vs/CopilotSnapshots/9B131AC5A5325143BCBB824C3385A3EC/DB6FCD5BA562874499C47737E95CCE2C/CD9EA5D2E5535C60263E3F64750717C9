using System.ComponentModel.DataAnnotations;

namespace SchoolDomain.Entities
{
    public class SubjectMaster
    {
        public int SubjectId { get; set; }

        [Required(ErrorMessage = "Subject name is required.")]
        [StringLength(100, MinimumLength = 1, ErrorMessage = "Subject name must be between 1 and 100 characters.")]
        public string SubjectName { get; set; } = string.Empty;

        [StringLength(50, ErrorMessage = "Subject code cannot exceed 50 characters.")]
        public string SubjectCode { get; set; } = string.Empty;

        [StringLength(20, ErrorMessage = "Short name cannot exceed 20 characters.")]
        public string ShortName { get; set; } = string.Empty;

        [Range(0, 1, ErrorMessage = "IsChoice must be 0 or 1.")]
        public byte IsChoice { get; set; }

        [Range(1, short.MaxValue, ErrorMessage = "Subject Type ID must be greater than 0.")]
        public short SubjectTypeId { get; set; }

        [StringLength(100, ErrorMessage = "Full text cannot exceed 100 characters.")]
        public string FullText { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Remarks cannot exceed 500 characters.")]
        public string Remarks { get; set; } = string.Empty;

        [Range(1, short.MaxValue, ErrorMessage = "Created User ID must be greater than 0.")]
        public short CreatedUserId { get; set; }

        [Range(1, long.MaxValue, ErrorMessage = "Login ID must be greater than 0.")]
        public long LoginId { get; set; }
    }
}
