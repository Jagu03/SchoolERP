using System.ComponentModel.DataAnnotations;

namespace SchoolDomain.Entities
{
    public class ClassSectionAllocation
    {
        public int AllocationId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Class ID must be greater than 0.")]
        public int ClassId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Section ID must be greater than 0.")]
        public int SectionId { get; set; }

        [Range(1, short.MaxValue, ErrorMessage = "Academic Year ID must be greater than 0.")]
        public short AcademicYearId { get; set; }

        [Range(0, 1, ErrorMessage = "IsActive must be 0 or 1.")]
        public byte IsActive { get; set; }

        [StringLength(500, ErrorMessage = "Remarks cannot exceed 500 characters.")]
        public string Remarks { get; set; } = string.Empty;

        [Range(1, short.MaxValue, ErrorMessage = "Created User ID must be greater than 0.")]
        public short CreatedUserId { get; set; }

        [Range(1, long.MaxValue, ErrorMessage = "Login ID must be greater than 0.")]
        public long LoginId { get; set; }
    }
}
